{
  "name": "server",
  "version": "1.0.0",
  "private": true,
  "description": "REST API Warung Madura Stock Manager (Express + Prisma + PostgreSQL)",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:defaults": "tsx prisma/seed-defaults.ts",
    "db:reset": "prisma migrate reset --force --skip-seed && npm run db:seed"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "@types/pg": "^8.23.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.5",
    "express": "^5.0.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.0.0",
    "prisma": "^6.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.3"
  }
}
