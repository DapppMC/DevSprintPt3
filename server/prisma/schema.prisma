generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StockMovementType {
  INITIAL
  SALE
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  RECEIPT
}

enum StockAdjustmentReason {
  HITUNG_ULANG
  RUSAK
  KEDALUWARSA
  HILANG
  LAINNYA
}

enum PurchaseOrderStatus {
  OPEN
  PARTIAL
  COMPLETE
  CANCELLED
}

enum GoodsReceiptRejectReason {
  PENYOK
  KEDALUWARSA
  LAINNYA
}

model Product {
  id                   String   @id @default(uuid()) @db.Uuid
  sku                  String   @unique
  name                 String
  category             String
  purchasePrice        Decimal  @db.Decimal(12, 2)
  sellingPrice         Decimal  @db.Decimal(12, 2)
  stock                Int      @default(0)
  isActive             Boolean  @default(true)
  baseUnit             String   @default("pcs")
  purchaseUnit         String   @default("pcs")
  unitsPerPurchaseUnit Int      @default(1)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  saleItems          SaleItem[]
  stockMovements     StockMovement[]
  purchaseOrderLines PurchaseOrderLine[]
  goodsReceiptLines  GoodsReceiptLine[]
}

model Supplier {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  purchaseOrders PurchaseOrder[]
  goodsReceipts  GoodsReceipt[]
}

enum Role {
  PEMILIK
  STAF
}

model Staff {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  goodsReceipts GoodsReceipt[]
  user          User?
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  username     String   @unique
  name         String
  passwordHash String
  role         Role     @default(STAF)
  staffId      String?  @unique @db.Uuid
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  staff        Staff?   @relation(fields: [staffId], references: [id], onDelete: SetNull)
  business     Business?
  conversationMembers ConversationMember[]
  messagesSent        Message[]

  @@index([role])
}

model RolePermission {
  id         String   @id @default(uuid()) @db.Uuid
  role       Role
  permission String
  createdAt  DateTime @default(now())

  @@unique([role, permission])
  @@index([role])
}

model PurchaseOrder {
  id           String              @id @default(uuid()) @db.Uuid
  orderNumber  String              @unique
  supplierId   String              @db.Uuid
  orderedAt    DateTime            @default(now())
  note         String?
  status       PurchaseOrderStatus @default(OPEN)
  cancelReason String?
  createdAt    DateTime            @default(now())

  supplier      Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  lines         PurchaseOrderLine[]
  goodsReceipts GoodsReceipt[]

  @@index([supplierId])
  @@index([createdAt])
}

model PurchaseOrderLine {
  id                   String   @id @default(uuid()) @db.Uuid
  purchaseOrderId      String   @db.Uuid
  productId            String   @db.Uuid
  orderedBase          Int
  fulfilledBase        Int      @default(0)
  cancelledBase        Int      @default(0)
  purchaseUnit         String
  unitsPerPurchaseUnit Int
  createdAt            DateTime @default(now())

  purchaseOrder     PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product           Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  goodsReceiptLines GoodsReceiptLine[]

  @@unique([purchaseOrderId, productId])
  @@index([purchaseOrderId])
  @@index([productId])
}

model GoodsReceipt {
  id              String   @id @default(uuid()) @db.Uuid
  receiptNumber   String   @unique
  idempotencyKey  String   @unique
  purchaseOrderId String?  @db.Uuid
  supplierId      String   @db.Uuid
  receivedById    String   @db.Uuid
  receivedAt      DateTime @default(now())
  note            String?
  createdAt       DateTime @default(now())

  purchaseOrder PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  supplier      Supplier           @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  receivedBy    Staff              @relation(fields: [receivedById], references: [id], onDelete: Restrict)
  lines         GoodsReceiptLine[]

  @@index([supplierId])
  @@index([receivedById])
  @@index([purchaseOrderId])
  @@index([createdAt])
}

model GoodsReceiptLine {
  id                       String                    @id @default(uuid()) @db.Uuid
  goodsReceiptId           String                    @db.Uuid
  productId                String                    @db.Uuid
  purchaseOrderLineId      String?                   @db.Uuid
  receivedBase             Int
  rejectedBase             Int                       @default(0)
  rejectReason             GoodsReceiptRejectReason?
  rejectNote               String?
  bonusBase                Int                       @default(0)
  purchaseUnit             String
  unitsPerPurchaseUnit     Int
  unitCostPerPurchaseUnit  Decimal                   @db.Decimal(12, 2)
  costPerBaseUnit          Decimal                   @db.Decimal(14, 4)
  effectiveCostPerBaseUnit Decimal                   @db.Decimal(14, 4)
  createdAt                DateTime                  @default(now())

  goodsReceipt      GoodsReceipt       @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  product           Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  purchaseOrderLine PurchaseOrderLine? @relation(fields: [purchaseOrderLineId], references: [id], onDelete: Restrict)

  @@index([goodsReceiptId])
  @@index([productId])
  @@index([purchaseOrderLineId])
}

model Sale {
  id            String   @id @default(uuid()) @db.Uuid
  invoiceNumber String   @unique
  total         Decimal  @db.Decimal(12, 2)
  createdAt     DateTime @default(now())

  items SaleItem[]

  @@index([createdAt])
}

model SaleItem {
  id        String  @id @default(uuid()) @db.Uuid
  saleId    String  @db.Uuid
  productId String  @db.Uuid
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)
  subtotal  Decimal @db.Decimal(12, 2)

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@index([productId])
}

model StockMovement {
  id            String                 @id @default(uuid()) @db.Uuid
  productId     String                 @db.Uuid
  type          StockMovementType
  quantity      Int
  beforeStock   Int
  afterStock    Int
  referenceType String?
  referenceId   String?
  reason        StockAdjustmentReason?
  note          String?
  createdAt     DateTime               @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([productId, createdAt])
}

enum BusinessSource {
  SELF
  DINAS
}

model Business {
  id           String         @id @default(uuid()) @db.Uuid
  name         String
  role         String
  desa         String
  district     String?
  address      String?
  latitude     Float?         // privat: dilarang bocor ke luar
  longitude    Float?         // privat: dilarang bocor ke luar
  publicLat    Float          // koordinat publik/desa
  publicLng    Float          // koordinat publik/desa
  source       BusinessSource @default(SELF)
  dedupeKey    String         @unique
  sourceUrl    String?
  contactPhone String?        // tersimpan di DB, disensor di output publik sesuai UU PDP
  userId       String?        @unique @db.Uuid
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  catalogItems CatalogItem[]

  @@index([publicLat, publicLng])
  @@index([role])
  @@index([source])
}

model CatalogItem {
  id               String   @id @default(uuid()) @db.Uuid
  businessId       String   @db.Uuid
  commodity        String
  unit             String
  priceMin         Decimal? @db.Decimal(12, 2)
  priceMax         Decimal? @db.Decimal(12, 2)
  capacityPerMonth Int?
  stock            Int?
  createdAt        DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([commodity])
}

model Conversation {
  id            String    @id @default(uuid()) @db.Uuid
  pairKey       String    @unique
  lastMessageAt DateTime?
  createdAt     DateTime  @default(now())

  members  ConversationMember[]
  messages Message[]

  @@index([lastMessageAt])
}

model ConversationMember {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @db.Uuid
  userId         String   @db.Uuid
  joinedAt       DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id              String   @id @default(uuid()) @db.Uuid
  seqId           Int      @default(autoincrement())
  conversationId  String   @db.Uuid
  senderId        String   @db.Uuid
  clientMessageId String
  body            String
  createdAt       DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@unique([senderId, clientMessageId])
  @@index([conversationId, seqId])
  @@index([conversationId, createdAt])
}

model ScraperRun {
  id           String    @id @default(uuid()) @db.Uuid
  sourceUrl    String
  itemsFound   Int       @default(0)
  itemsSaved   Int       @default(0)
  itemsSkipped Int       @default(0)
  logs         Json?
  status       String    @default("SUCCESS")
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
}

