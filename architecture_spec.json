{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "project": "warung-madura-stock-manager",
  "title": "Enterprise Overhaul Architecture Specification",
  "version": "2.1.0",
  "architect": "Antigravity 1 / Worker 1 (ahmaddafa1017@gmail.com)",
  "status": "APPROVED",
  "sprint": "Warung Madura Polish & Overhaul",
  "directives": {
    "brandLogo": {
      "assetPath": "/warung-madura-logo.jpg",
      "publicLocation": "client/public/warung-madura-logo.jpg",
      "assetLocation": "client/src/assets/warung-madura-logo.jpg",
      "specification": "Replace placeholder WM lettermark with authentic Warung Madura photograph logo across Sidebar, Login Page, and Receipt Slips. Aspect ratio: square cover with rounded borders."
    },
    "darkMode": {
      "strategy": "Tailwind CSS v4 custom variant (@custom-variant dark) paired with ThemeContext",
      "persistenceKey": "wm_theme",
      "systemFallback": "prefers-color-scheme: dark",
      "highContrastPalette": {
        "pageBackground": "dark:bg-slate-950",
        "cardBackground": "dark:bg-slate-900/90",
        "cardBorder": "dark:border-slate-800",
        "primaryText": "dark:text-slate-100",
        "secondaryText": "dark:text-slate-300",
        "mutedText": "dark:text-slate-400",
        "inputBackground": "dark:bg-slate-800",
        "inputBorder": "dark:border-slate-700"
      },
      "toggleComponent": "Sun/Moon Lucide icon button placed in Layout header/sidebar with tooltip and smooth transition."
    },
    "iconography": {
      "policy": "Strict Zero-Emoji Policy (No raw unicode emojis). All UI iconography must use Lucide React SVG components.",
      "replacements": [
        { "original": "👑", "replacement": "Crown", "library": "lucide-react", "usage": "Owner role / Cak Rofi badge & demo switcher" },
        { "original": "👤", "replacement": "User", "library": "lucide-react", "usage": "Staff role / Udin & Sari badge & demo switcher" },
        { "original": "📦", "replacement": "Package", "library": "lucide-react", "usage": "Stock movement filter (Goods Receipt) & products" },
        { "original": "🛒", "replacement": "ShoppingCart", "library": "lucide-react", "usage": "Stock movement filter (Sale) & POS checkout" },
        { "original": "⚖️", "replacement": "Scale", "library": "lucide-react", "usage": "Stock movement filter (Adjustment)" },
        { "original": "🌱", "replacement": "Sprout", "library": "lucide-react", "usage": "Stock movement filter (Initial Stock)" },
        { "original": "🔒", "replacement": "Lock", "library": "lucide-react", "usage": "Financial cost/omset sensor indicator" },
        { "original": "📍", "replacement": "MapPin", "library": "lucide-react", "usage": "Location indicator in ChatWidget" },
        { "original": "🗺️", "replacement": "Map", "library": "lucide-react", "usage": "Google Maps link in ChatWidget" },
        { "original": "🎁", "replacement": "Gift", "library": "lucide-react", "usage": "Goods receipt bonus indicator" },
        { "original": "❌", "replacement": "AlertTriangle", "library": "lucide-react", "usage": "Goods receipt reject indicator" }
      ]
    },
    "seedingMatrix": {
      "description": "Comprehensive dummy data seeded for supervisor evaluation covering all business permutations.",
      "purchaseOrders": [
        { "orderNumber": "PO-20261020-0001", "status": "OPEN", "supplier": "PT Sembako Nusantara Jaya", "description": "Belum diterima sama sekali" },
        { "orderNumber": "PO-20261021-0002", "status": "PARTIAL", "supplier": "Grosir Berkah Sembako", "description": "Diterima sebagian (3 dari 5 dus)" },
        { "orderNumber": "PO-20261022-0003", "status": "COMPLETE", "supplier": "Distributor Kopi & Minuman Sejahtera", "description": "Tuntas 100% via Goods Receipt" },
        { "orderNumber": "PO-20261023-0004", "status": "CANCELLED", "supplier": "CV Surya Madura Abadi", "description": "Dibatalkan pemilik karena stok supplier habis" }
      ],
      "goodsReceipts": [
        { "receiptNumber": "GR-20261021-0001", "variant": "NORMAL", "description": "Penerimaan standar tanpa bonus atau reject" },
        { "receiptNumber": "GR-20261022-0002", "variant": "WITH_BONUS", "bonusBase": 12, "description": "Penerimaan dengan bonus ekstra distributor" },
        { "receiptNumber": "GR-20261022-0003", "variant": "WITH_REJECT", "rejectedBase": 4, "rejectReason": "PENYOK", "description": "Penerimaan dengan barang reject kemasan rusak" }
      ],
      "stockMovements": ["INITIAL", "RECEIPT", "SALE", "ADJUSTMENT_IN", "ADJUSTMENT_OUT"],
      "salesHistory": "Transactions distributed over the past 3 days and today for realistic dashboard metrics."
    }
  },
  "database": {
    "engine": "PostgreSQL 15+",
    "orm": "Prisma 6",
    "normalForm": "3NF",
    "enums": {
      "Role": ["PEMILIK", "STAF"],
      "StockMovementType": ["INITIAL", "SALE", "ADJUSTMENT_IN", "ADJUSTMENT_OUT", "RECEIPT"],
      "StockAdjustmentReason": ["HITUNG_ULANG", "RUSAK", "KEDALUWARSA", "HILANG", "LAINNYA"],
      "PurchaseOrderStatus": ["OPEN", "PARTIAL", "COMPLETE", "CANCELLED"],
      "GoodsReceiptRejectReason": ["PENYOK", "KEDALUWARSA", "LAINNYA"],
      "BusinessSource": ["SELF", "DINAS"]
    },
    "tables": [
      {
        "name": "User",
        "primaryKey": "id",
        "columns": {
          "id": "UUID",
          "username": "VARCHAR(50) UNIQUE",
          "name": "VARCHAR(100)",
          "passwordHash": "VARCHAR(255)",
          "role": "Role",
          "staffId": "UUID NULL FK(Staff.id)",
          "isActive": "BOOLEAN",
          "createdAt": "TIMESTAMPTZ",
          "updatedAt": "TIMESTAMPTZ"
        }
      },
      {
        "name": "RolePermission",
        "primaryKey": "id",
        "columns": {
          "id": "UUID",
          "role": "Role",
          "permission": "VARCHAR(50)",
          "createdAt": "TIMESTAMPTZ"
        },
        "uniqueConstraints": [["role", "permission"]]
      },
      {
        "name": "Staff",
        "primaryKey": "id",
        "columns": {
          "id": "UUID",
          "name": "VARCHAR(100) UNIQUE",
          "isActive": "BOOLEAN",
          "createdAt": "TIMESTAMPTZ"
        }
      },
      {
        "name": "Product",
        "primaryKey": "id",
        "columns": {
          "id": "UUID",
          "sku": "VARCHAR(50) UNIQUE",
          "name": "VARCHAR(255)",
          "category": "VARCHAR(100)",
          "purchasePrice": "DECIMAL(12,2)",
          "sellingPrice": "DECIMAL(12,2)",
          "stock": "INTEGER (CHECK stock >= 0)",
          "isActive": "BOOLEAN",
          "baseUnit": "VARCHAR(20)",
          "purchaseUnit": "VARCHAR(20)",
          "unitsPerPurchaseUnit": "INTEGER (CHECK unitsPerPurchaseUnit >= 1)",
          "createdAt": "TIMESTAMPTZ",
          "updatedAt": "TIMESTAMPTZ"
        }
      },
      {
        "name": "Supplier",
        "primaryKey": "id",
        "columns": {
          "id": "UUID",
          "name": "VARCHAR(150) UNIQUE",
          "phone": "VARCHAR(50) NULL",
          "isActive": "BOOLEAN",
          "createdAt": "TIMESTAMPTZ"
        }
      },
      {
        "name": "PurchaseOrder",
        "primaryKey": "id",
        "columns": {
          "id": "UUID",
          "orderNumber": "VARCHAR(50) UNIQUE",
          "supplierId": "UUID FK(Supplier.id)",
          "orderedAt": "TIMESTAMPTZ",
          "note": "TEXT NULL",
          "status": "PurchaseOrderStatus",
          "cancelReason": "TEXT NULL",
          "createdAt": "TIMESTAMPTZ"
        }
      },
      {
        "name": "PurchaseOrderLine",
        "primaryKey": "id",
        "columns": {
          "id": "UUID",
          "purchaseOrderId": "UUID FK(PurchaseOrder.id)",
          "productId": "UUID FK(Product.id)",
          "orderedBase": "INTEGER",
          "fulfilledBase": "INTEGER",
          "cancelledBase": "INTEGER",
          "purchaseUnit": "VARCHAR(20)",
          "unitsPerPurchaseUnit": "INTEGER",
          "createdAt": "TIMESTAMPTZ"
        },
        "uniqueConstraints": [["purchaseOrderId", "productId"]]
      },
      {
        "name": "GoodsReceipt",
        "primaryKey": "id",
        "columns": {
          "id": "UUID",
          "receiptNumber": "VARCHAR(50) UNIQUE",
          "idempotencyKey": "VARCHAR(100) UNIQUE",
          "purchaseOrderId": "UUID NULL FK(PurchaseOrder.id)",
          "supplierId": "UUID FK(Supplier.id)",
          "receivedById": "UUID FK(Staff.id)",
          "receivedAt": "TIMESTAMPTZ",
          "note": "TEXT NULL",
          "createdAt": "TIMESTAMPTZ"
        }
      },
      {
        "name": "GoodsReceiptLine",
        "primaryKey": "id",
        "columns": {
          "id": "UUID",
          "goodsReceiptId": "UUID FK(GoodsReceipt.id)",
          "productId": "UUID FK(Product.id)",
          "purchaseOrderLineId": "UUID NULL FK(PurchaseOrderLine.id)",
          "receivedBase": "INTEGER",
          "rejectedBase": "INTEGER",
          "rejectReason": "GoodsReceiptRejectReason NULL",
          "rejectNote": "TEXT NULL",
          "bonusBase": "INTEGER",
          "purchaseUnit": "VARCHAR(20)",
          "unitsPerPurchaseUnit": "INTEGER",
          "unitCostPerPurchaseUnit": "DECIMAL(12,2)",
          "createdAt": "TIMESTAMPTZ"
        }
      },
      {
        "name": "Sale",
        "primaryKey": "id",
        "columns": {
          "id": "UUID",
          "invoiceNumber": "VARCHAR(50) UNIQUE",
          "total": "DECIMAL(12,2)",
          "createdAt": "TIMESTAMPTZ"
        }
      },
      {
        "name": "SaleItem",
        "primaryKey": "id",
        "columns": {
          "id": "UUID",
          "saleId": "UUID FK(Sale.id)",
          "productId": "UUID FK(Product.id)",
          "quantity": "INTEGER",
          "unitPrice": "DECIMAL(12,2)",
          "subtotal": "DECIMAL(12,2)"
        }
      },
      {
        "name": "StockMovement",
        "primaryKey": "id",
        "columns": {
          "id": "UUID",
          "productId": "UUID FK(Product.id)",
          "type": "StockMovementType",
          "quantity": "INTEGER",
          "beforeStock": "INTEGER",
          "afterStock": "INTEGER",
          "referenceType": "VARCHAR(50) NULL",
          "referenceId": "VARCHAR(100) NULL",
          "reason": "StockAdjustmentReason NULL",
          "note": "TEXT NULL",
          "createdAt": "TIMESTAMPTZ"
        }
      },
      {
        "name": "Business",
        "primaryKey": "id",
        "columns": {
          "id": "UUID",
          "name": "VARCHAR(255)",
          "role": "VARCHAR(50)",
          "desa": "VARCHAR(100)",
          "district": "VARCHAR(100) NULL",
          "address": "TEXT NULL",
          "latitude": "FLOAT NULL (PRIVATE)",
          "longitude": "FLOAT NULL (PRIVATE)",
          "publicLat": "FLOAT (PUBLIC)",
          "publicLng": "FLOAT (PUBLIC)",
          "source": "BusinessSource",
          "dedupeKey": "VARCHAR(255) UNIQUE",
          "sourceUrl": "TEXT NULL",
          "contactPhone": "VARCHAR(50) NULL (MASKED IN PUBLIC)",
          "userId": "UUID NULL UNIQUE FK(User.id)",
          "createdAt": "TIMESTAMPTZ",
          "updatedAt": "TIMESTAMPTZ"
        }
      },
      {
        "name": "CatalogItem",
        "primaryKey": "id",
        "columns": {
          "id": "UUID",
          "businessId": "UUID FK(Business.id)",
          "commodity": "VARCHAR(100)",
          "unit": "VARCHAR(20)",
          "priceMin": "DECIMAL(12,2) NULL",
          "priceMax": "DECIMAL(12,2) NULL",
          "capacityPerMonth": "INTEGER NULL",
          "stock": "INTEGER NULL",
          "createdAt": "TIMESTAMPTZ"
        }
      },
      {
        "name": "Conversation",
        "primaryKey": "id",
        "columns": {
          "id": "UUID",
          "pairKey": "VARCHAR(100) UNIQUE",
          "lastMessageAt": "TIMESTAMPTZ NULL",
          "createdAt": "TIMESTAMPTZ"
        }
      },
      {
        "name": "ConversationMember",
        "primaryKey": "id",
        "columns": {
          "id": "UUID",
          "conversationId": "UUID FK(Conversation.id)",
          "userId": "UUID FK(User.id)",
          "joinedAt": "TIMESTAMPTZ"
        },
        "uniqueConstraints": [["conversationId", "userId"]]
      },
      {
        "name": "Message",
        "primaryKey": "id",
        "columns": {
          "id": "UUID",
          "seqId": "SERIAL",
          "conversationId": "UUID FK(Conversation.id)",
          "senderId": "UUID FK(User.id)",
          "clientMessageId": "VARCHAR(100)",
          "body": "TEXT",
          "createdAt": "TIMESTAMPTZ"
        },
        "uniqueConstraints": [["senderId", "clientMessageId"]]
      },
      {
        "name": "ScraperRun",
        "primaryKey": "id",
        "columns": {
          "id": "UUID",
          "sourceUrl": "TEXT",
          "itemsFound": "INTEGER",
          "itemsSaved": "INTEGER",
          "itemsSkipped": "INTEGER",
          "logs": "JSON NULL",
          "status": "VARCHAR(50)",
          "startedAt": "TIMESTAMPTZ",
          "completedAt": "TIMESTAMPTZ NULL"
        }
      }
    ]
  },
  "rbacMatrix": {
    "permissions": [
      "stock:read",
      "stock:adjust",
      "goods_receipt:read",
      "goods_receipt:create",
      "purchase_order:read",
      "purchase_order:manage",
      "product:read",
      "product:manage",
      "cost:view",
      "dashboard:financial",
      "sales:manage",
      "supplier:manage",
      "staff:manage",
      "permission:manage"
    ],
    "defaultRoles": {
      "PEMILIK": [
        "stock:read", "stock:adjust",
        "goods_receipt:read", "goods_receipt:create",
        "purchase_order:read", "purchase_order:manage",
        "product:read", "product:manage",
        "cost:view", "dashboard:financial",
        "sales:manage", "supplier:manage",
        "staff:manage", "permission:manage"
      ],
      "STAF": [
        "stock:read",
        "goods_receipt:read",
        "goods_receipt:create",
        "purchase_order:read",
        "product:read",
        "sales:manage"
      ]
    }
  },
  "apiEndpoints": [
    { "method": "POST", "path": "/api/auth/login", "auth": false, "rateLimited": true },
    { "method": "GET", "path": "/api/auth/me", "auth": true },
    { "method": "GET", "path": "/api/permissions", "auth": true },
    { "method": "PUT", "path": "/api/permissions/:role", "auth": true, "role": "PEMILIK" },
    { "method": "GET", "path": "/api/products", "auth": true, "masking": "cost:view" },
    { "method": "GET", "path": "/api/products/:id", "auth": true, "masking": "cost:view" },
    { "method": "POST", "path": "/api/products", "auth": true, "permission": "product:manage" },
    { "method": "PATCH", "path": "/api/products/:id", "auth": true, "permission": "product:manage" },
    { "method": "DELETE", "path": "/api/products/:id", "auth": true, "permission": "product:manage" },
    { "method": "GET", "path": "/api/purchase-orders", "auth": true },
    { "method": "GET", "path": "/api/purchase-orders/:id", "auth": true },
    { "method": "POST", "path": "/api/purchase-orders", "auth": true, "permission": "purchase_order:manage" },
    { "method": "POST", "path": "/api/purchase-orders/:id/cancel-remaining", "auth": true, "permission": "purchase_order:manage" },
    { "method": "GET", "path": "/api/goods-receipts", "auth": true },
    { "method": "GET", "path": "/api/goods-receipts/:id", "auth": true, "masking": "cost:view" },
    { "method": "POST", "path": "/api/goods-receipts", "auth": true, "permission": "goods_receipt:create", "antiImpersonation": true, "idempotent": true, "masking": "cost:view" },
    { "method": "GET", "path": "/api/stock-movements", "auth": true, "permission": "stock:read" },
    { "method": "POST", "path": "/api/stock-adjustments", "auth": true, "permission": "stock:adjust" },
    { "method": "GET", "path": "/api/dashboard", "auth": true, "masking": "dashboard:financial" },
    { "method": "GET", "path": "/api/sales", "auth": true },
    { "method": "POST", "path": "/api/sales", "auth": true },
    { "method": "GET", "path": "/api/businesses", "auth": false },
    { "method": "GET", "path": "/api/businesses/nearby", "auth": false },
    { "method": "GET", "path": "/api/chat/conversations", "auth": true },
    { "method": "POST", "path": "/api/chat/messages", "auth": true }
  ],
  "verificationMatrix": {
    "testRunner": "vitest run --fileParallelism=false",
    "suites": [
      { "file": "test/e2e-api.test.ts", "count": 20, "expected": "PASS" },
      { "file": "test/scenarios.test.ts", "count": 20, "expected": "PASS" },
      { "file": "test/rbac-comprehensive.test.ts", "count": 14, "expected": "PASS" },
      { "file": "test/boundary-edge-adversarial.test.ts", "count": 13, "expected": "PASS" },
      { "file": "test/unit-business-logic.test.ts", "count": 13, "expected": "PASS" },
      { "file": "test/k1-k17.test.ts", "count": 13, "expected": "PASS" },
      { "file": "test/rbac.test.ts", "count": 8, "expected": "PASS" },
      { "file": "test/acid-transactions.test.ts", "count": 6, "expected": "PASS" },
      { "file": "test/t1-t11.test.ts", "count": 1, "expected": "PASS" }
    ],
    "totalTests": 108,
    "passRateTarget": "100%",
    "certifiedStatus": "100% PASS RATE CERTIFIED (108/108 PASS)"
  }
}
