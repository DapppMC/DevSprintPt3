{
  "name": "warung-madura-stock-manager",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Training sandbox: aplikasi stok dan penjualan untuk Warung Madura (PERN + Tailwind)",
  "engines": {
    "node": ">=20.19.0"
  },
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "postinstall": "npm run db:generate -w server",
    "dev": "concurrently -n server,client -c green,cyan \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w server && npm run build -w client",
    "test": "npm run test -w server",
    "test:all": "python3 run_all_tests.py",
    "lint": "eslint .",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w client",
    "start": "node server.js",
    "db:generate": "npm run db:generate -w server",
    "db:migrate": "npm run db:migrate -w server",
    "db:migrate:dev": "npm run db:migrate:dev -w server",
    "db:seed": "npm run db:seed -w server",
    "db:seed:defaults": "npm run db:seed:defaults -w server",
    "db:reset": "npm run db:reset -w server"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "concurrently": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.65.0"
  }
}
